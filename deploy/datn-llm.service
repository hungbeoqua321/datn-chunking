[Unit]
Description=ĐATN — mô hình sinh tại chỗ (llama-server, endpoint tương thích OpenAI)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/datn-chunking
ExecStart=/home/ubuntu/datn-chunking/tools/chay-llm.sh
Restart=always
RestartSec=5
CPUWeight=1
AllowedCPUs=1-3
MemoryMax=6G
Nice=19
IOWeight=10
OOMScoreAdjust=500
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
