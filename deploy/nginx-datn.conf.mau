# nginx site cho web đồ án — SINH từ mẫu này bằng deploy/render.sh (thay ${DATN_HOST}).
# Hostname: ${DATN_HOST} (sslip.io tự phân giải về IP nằm trong tên, không cần cấu hình DNS).
# certbot --nginx sẽ tự thêm khối 443 + chuyển hướng http→https vào file đã cài.
limit_req_zone $binary_remote_addr zone=datn_hoi:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=datn_web:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=datn_conn:10m;

server {
    server_name ${DATN_HOST};
    access_log /var/log/nginx/datn-access.log;
    error_log  /var/log/nginx/datn-error.log;
    client_max_body_size 8k;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    # hỏi đáp: luồng SSE dài (mô hình sinh chạy CPU ~1–2 phút) → không đệm, chờ lâu
    location = /api/hoi {
        limit_req zone=datn_hoi burst=3 nodelay;
        limit_conn datn_conn 2;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location / {
        limit_req zone=datn_web burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
